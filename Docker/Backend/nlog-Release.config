<?xml version="1.0" encoding="utf-8" ?>
<nlog xmlns="http://www.nlog-project.org/schemas/NLog.xsd"
      xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
      autoReload="true"
      throwConfigExceptions="true"
      internalLogLevel="Warn"
      internalLogToConsole="true">

  <!-- This is the config that SHIPS: Dockerfile copies it to ./nlog.config. Keep it in step with
       Source/Regard.Backend/nlog.config (dev), which differs only in log level and console type.
       NLogConfigTests loads all of them so a typo here cannot reach an image. -->

  <variable name="LogDirectory"
            value="${gdc:item=DataDirectory}/Logs"/>

  <!-- enable asp.net core layout renderers -->
  <extensions>
    <add assembly="NLog.Web.AspNetCore"/>
  </extensions>

  <!-- the targets to write to -->
  <targets>

    <target xsi:type="Console"
            name="console"
            layout="${logger:padding=-45}  ${level:truncate=4:uppercase=true}:  ${message}${exception:format=tostring}" />

    <!-- Single file target; see the dev config for why csvFile is gone, why its callsite /
         request-url / MVC-action columns are folded into this layout, and why the archive
         attributes are exactly these three. -->
    <target xsi:type="File"
            name="txtFile"
            fileName="${LogDirectory}/regard-${shortdate}.log"
            layout="${longdate}|${event-properties:item=EventId_Id:whenEmpty=0}|${uppercase:${level}}|${logger}|${callsite}|${aspnet-request-url}|${aspnet-mvc-action}|${message} ${exception:format=tostring}"
            archiveAboveSize="10485760"
            maxArchiveDays="14"
            maxArchiveFiles="60" />

  </targets>

  <!-- rules to map from logger name to target -->
  <rules>

    <!--Hosting lifetime messages must come BEFORE the Microsoft.* blackhole, which is
        maxlevel="Info" final="true" and would otherwise swallow them.-->
    <logger name="Microsoft.Hosting.Lifetime" minlevel="Info" writeTo="console, txtFile" final="true" />

    <!--Skip non-critical Microsoft logs and so log only own logs-->
    <logger name="Microsoft.*" maxlevel="Info" final="true" writeTo="" />
    <logger name="Quartz.*" maxlevel="Info" final="true" writeTo="" />
    <!-- BlackHole -->

    <!--All logs, including from Microsoft-->
    <logger name="*" minlevel="Info" writeTo="console, txtFile" />

  </rules>
</nlog>
