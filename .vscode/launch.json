{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Regard.Backend",
      "type": "coreclr",
      "request": "launch",
      "preLaunchTask": "build",
      "program": "${workspaceFolder}/Source/Regard.Backend/bin/Debug/net10.0/Regard.Backend.dll",
      "cwd": "${workspaceFolder}/Source/Regard.Backend",
      "console": "internalConsole",
      "stopAtEntry": false,
      "env": {
        "ASPNETCORE_ENVIRONMENT": "Development",
        "ASPNETCORE_URLS": "http://localhost:9585",
        "DataDirectory": "${workspaceFolder}/.dev/data",
        "DownloadDirectory": "${workspaceFolder}/.dev/videos",
        "REGARD_MIGRATE": "1",
        "PATH": "${env:HOME}/.deno/bin:${env:PATH}"
      }
    },
    {
      "name": "Regard.Frontend (Blazor WASM)",
      "type": "blazorwasm",
      "request": "launch",
      "cwd": "${workspaceFolder}/Source/Regard.Frontend",
      "url": "http://localhost:5000",
      "browser": "chrome",
      "runtimeExecutable": "/usr/bin/chromium-browser"
    }
  ],
  "compounds": [
    {
      "name": "Regard (full stack)",
      "configurations": ["Regard.Backend", "Regard.Frontend (Blazor WASM)"],
      "stopAll": true
    }
  ]
}
