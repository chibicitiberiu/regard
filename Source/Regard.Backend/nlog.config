<?xml version="1.0" encoding="utf-8" ?>
<nlog xmlns="http://www.nlog-project.org/schemas/NLog.xsd"
      xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
      autoReload="true"
      throwConfigExceptions="true"
      internalLogLevel="Warn"
      internalLogToConsole="true">

  <!-- internalLogLevel without a sink goes nowhere, which is why the obsolete archive attributes
       this config used to carry never announced themselves. Keep the console sink. -->

  <variable name="LogDirectory"
            value="${gdc:item=DataDirectory}/Logs"/>

  <!-- enable asp.net core layout renderers -->
  <extensions>
    <add assembly="NLog.Web.AspNetCore"/>
  </extensions>

  <!-- the targets to write to -->
  <targets>

    <target xsi:type="ColoredConsole"
            name="console"
            useDefaultRowHighlightingRules="true"
            layout="${logger:padding=-45}  ${level:truncate=4:uppercase=true}:  ${message}${exception:format=tostring}" />

    <target xsi:type="Debugger"
            name="debugger"
            layout="${logger:padding=-45}  ${level:truncate=4:uppercase=true}:  ${message}${exception:format=tostring}" />

    <!-- The one file target. There used to be a second, csvFile, carrying the same events again with
         three extra columns; it doubled every write and nothing read it. Those columns (callsite,
         request URL, MVC action) are folded in below, so the format stays a fixed 8 pipe-delimited
         fields — empty ones included — because it is meant to be machine-parsed, not just eyeballed.

         Archiving is NLog 6 idiom and deliberately minimal. `fileName` carries ${shortdate}, so the
         file rolls by date on its own; NLog builds its cleanup wildcard from that name
         (regard-2026-09-03.log -> regard*log) and applies both limits at every new-file open. Do NOT
         reintroduce archiveFileName / archiveNumbering / archiveEvery: NLog 6 marks the first two
         legacy, and both archiveEvery and archiveFileName only work when fileName is *static*, which
         it is not here. maxArchiveDays is the real retention knob; maxArchiveFiles is a backstop for
         pathological size-rolling, set high enough not to undercut the day limit (note that 0 is not
         "unlimited" — it selects a handler that truncates the active log). -->
    <target xsi:type="File"
            name="txtFile"
            fileName="${LogDirectory}/regard-${shortdate}.log"
            layout="${longdate}|${event-properties:item=EventId_Id:whenEmpty=0}|${uppercase:${level}}|${logger}|${callsite}|${aspnet-request-url}|${aspnet-mvc-action}|${message} ${exception:format=tostring}"
            archiveAboveSize="10485760"
            maxArchiveDays="14"
            maxArchiveFiles="60" />

  </targets>

  <!-- rules to map from logger name to target -->
  <rules>

    <!--Hosting lifetime messages ("Now listening on: ...") must come BEFORE the Microsoft.* blackhole
        below: that rule is maxlevel="Info" final="true", so it swallowed these and this rule was dead. -->
    <logger name="Microsoft.Hosting.Lifetime" minlevel="Info" writeTo="console, txtFile" final="true" />

    <!--Skip non-critical Microsoft logs and so log only own logs-->
    <logger name="Microsoft.*" maxlevel="Info" final="true" writeTo="" />
    <logger name="Quartz.*" maxlevel="Info" final="true" writeTo="" />
    <!-- BlackHole -->

    <!--All logs, including from Microsoft-->
    <logger name="*" minlevel="Debug" writeTo="console, txtFile, debugger" />

  </rules>
</nlog>
