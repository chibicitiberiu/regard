{
  // Database: SQLite is the default and needs no configuration (the file is created
  // under DataDirectory). To use SQL Server instead, set ConnectionStrings:SqlServer.
  "ConnectionStrings": {
    //"SqlServer": "Data Source=localhost\\SQLEXPRESS;Initial Catalog=Regard;Integrated Security=True;Pooling=False",
    //"SQLite": "Data Source=Regard.db"
  },

  // JWT signing secret. Leave empty and Regard generates a strong random secret on first boot
  // and stores it at {DataDirectory}/jwt-secret. To set your own, provide it here or via the
  // JWT__Secret environment variable.
  "JWT": {
    "Secret": ""
  },

  // Directory where application data (including the SQLite database) will be stored.
  "DataDirectory": "Data",

  // Root directory where videos will be downloaded. Server-wide default; can be overridden.
  "DownloadDirectory": "Data/Videos",

  // CORS header, change it to only contain the frontend hostname
  "AllowedHosts": "*",

  // External base URL of this instance, used to build absolute links in outgoing mail (e.g. the
  // password-reset link). Set this in any real deployment behind a reverse proxy; when empty the
  // backend derives scheme+host from the request, which is only correct same-origin.
  // Can also be set via REGARD_PUBLIC_BASE_URL.
  "PublicBaseUrl": "",

  // Outgoing SMTP, used to email password-reset links. Leave Host empty to disable email — the reset
  // link is then written to the server log (Warning level) so an admin can hand it to the user.
  // Each value can also be set via REGARD_SMTP_HOST / _PORT / _USER / _PASSWORD / _FROM / _USESSL.
  "Smtp": {
    "Host": "",
    "Port": 587,
    "User": "",
    "Password": "",
    "From": "",
    "UseSsl": true
  },

  // How often videos are synchronized. CRON pattern:
  // https://www.quartz-scheduler.net/documentation/quartz-3.x/tutorial/crontriggers.html
  "SynchronizationSchedule": "0 0/15 * * * ?",

  // If set to true, debug messages (including exception details) are sent to the frontend/API
  // responses. Off by default so stack traces stay in the data-directory log files only.
  "Debug": false,

  // URL pointing to the latest youtube-dl download location (replaced by yt-dlp in a later step).
  "YoutubeDLLatestUrl": "https://github.com/yt-dlp/yt-dlp/releases/latest/download/yt-dlp",

  // YoutubeDL options
  "YoutubeDL": {
    // If true, Regard manages youtube-dl automatically. If false, ExeLocation must be set.
    "AutoManage": true,
    "LatestUrl": "https://github.com/yt-dlp/yt-dlp/releases/latest/download/yt-dlp",
    // Points to the youtube-dl executable, only used if AutoManage=false
    "ExeLocation": null
  },

  // Jellyfin/Kodi metadata export. When enabled, Regard writes NFO sidecars + poster/thumbnail
  // images next to each download and names files as "SxxExx - Title" so a Jellyfin "Shows"
  // library displays channels as shows and videos as episodes. (Season = publish year,
  // episode = playlist index.) Requires ffmpeg on PATH (already needed for merges).
  "Metadata": {
    "Enabled": false
  },

  // Jellyfin watched-sync: poll Jellyfin for played videos and mark them watched in Regard
  // (which, per subscription settings, deletes the file and pulls the next one). Matches videos
  // by full file path, so the download volume MUST be mounted at the same absolute path in both
  // the Regard and Jellyfin containers, with the Jellyfin library pointed there, and
  // DownloadDirectory MUST be an absolute path.
  "Jellyfin": {
    "Enabled": false,
    "BaseUrl": "",          // e.g. http://jellyfin:8096
    "ApiKey": "",           // Jellyfin API key (Dashboard -> API Keys, admin)
    "JellyfinUser": "",     // the Jellyfin account whose "played" state to read
    "RegardUser": "",       // Regard account that owns the videos (defaults to JellyfinUser)
    "PollSchedule": "0 0/10 * * * ?"
  }
}
