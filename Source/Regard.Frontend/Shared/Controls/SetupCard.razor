@* Centered card used by the first-run setup wizard (Welcome / Admin / Finish). *@
@inject Regard.Services.AppController AppCtrl

<div class="setup-wrap">
    <div class="setup-card">
        <div class="setup-eyebrow">@EyebrowText</div>
        @if (!string.IsNullOrWhiteSpace(Title))
        {
            <h1 class="setup-title">@Title</h1>
        }
        <div class="setup-body">
            @ChildContent
        </div>
    </div>
</div>

@code {
    [Parameter] public string Title { get; set; }

    /// <summary>Optional eyebrow override; defaults to "Step N of X".</summary>
    [Parameter] public string Eyebrow { get; set; }

    [Parameter] public RenderFragment ChildContent { get; set; }

    private string EyebrowText =>
        !string.IsNullOrWhiteSpace(Eyebrow) ? Eyebrow
        : $"Step {AppCtrl.SetupStepNumber} of {AppCtrl.SetupStepCount}";
}
