<div class="video-list">
<div class="toolbar">

    <input type="search" placeholder="Search" @onchange="@OnQueryChanged" />

    <div class="button-group">
        <button @ref="orderButton" type="button" title="Order" @onclick="OnOrderClicked">
            <Icon Glyph="Icons.Sort" />
        </button>
        <button @ref="filterButton" type="button" title="Filter"
                class="@CssUtils.BoolToClass(HasActiveFilter, "primary")"
                @onclick="OnFilterClicked">
            <Icon Glyph="Icons.Filter" />
        </button>
    </div>

    <Menu AttachTo="orderButton" @bind-IsVisible="orderMenuVisible">
        @foreach (var option in Enum.GetValues(typeof(Regard.Model.VideoOrder)).Cast<Regard.Model.VideoOrder>())
        {
            <CheckMenuItem IsChecked="@(option == this.order)"
                           Click="() => SetOrder(option)">
                @option.Humanize()
            </CheckMenuItem>
        }
    </Menu>

    <Menu AttachTo="filterButton" @bind-IsVisible="filterMenuVisible">
        <li class="menu-section-label">Watch state</li>
        <CheckMenuItem IsChecked="@(watchState == Regard.Model.VideoWatchState.All)"
                       Click="() => SetWatchState(Regard.Model.VideoWatchState.All)">All</CheckMenuItem>
        <CheckMenuItem IsChecked="@(watchState == Regard.Model.VideoWatchState.Unwatched)"
                       Click="() => SetWatchState(Regard.Model.VideoWatchState.Unwatched)">Unwatched</CheckMenuItem>
        <CheckMenuItem IsChecked="@(watchState == Regard.Model.VideoWatchState.Started)"
                       Click="() => SetWatchState(Regard.Model.VideoWatchState.Started)">Started</CheckMenuItem>
        <CheckMenuItem IsChecked="@(watchState == Regard.Model.VideoWatchState.Watched)"
                       Click="() => SetWatchState(Regard.Model.VideoWatchState.Watched)">Watched</CheckMenuItem>
        <MenuSeparator />
        <li class="menu-section-label">Downloaded</li>
        <CheckMenuItem IsChecked="@(!isDownloaded.HasValue)"
                       Click="() => SetFilterIsDownloaded(null)">All</CheckMenuItem>
        <CheckMenuItem IsChecked="@(isDownloaded == true)"
                       Click="() => SetFilterIsDownloaded(true)">Downloaded</CheckMenuItem>
        <CheckMenuItem IsChecked="@(isDownloaded == false)"
                       Click="() => SetFilterIsDownloaded(false)">Not downloaded</CheckMenuItem>
    </Menu>

    @if (CanAddVideo)
    {
        <div class="button-group toolbar-add-video">
            <button type="button" title="Add a video to this subscription" @onclick="OnAddVideoClicked">
                <Icon Glyph="Icons.VideoAdd" />
            </button>
        </div>
    }
</div>

<VideoAddModal @ref="videoAddModal" />

@if (initialized && videos.Count == 0)
{
    <div class="empty-state">
        <p class="empty-state-title">@EmptyStateTitle</p>
        @if (EmptyStateHint != null)
        {
            <p class="empty-state-hint">@EmptyStateHint</p>
        }
    </div>
}
else
{
<ListView Model="VideoViewModel"
          ItemsSource="videos"
          Class="video-gallery">
    <ItemTemplate Context="item">
        <div class="video @CssUtils.BoolToClass(item.ApiVideo.IsWatched, "video-watched")">
            <div class="video-image">
                <NavLink class="video-image-wrapper" href="@($"/watch/{item.ApiVideo.Id}")">
                    <img src="@item.ThumbnailUrl" />
                    <div class="video-badges">
                        @if (item.ApiVideo.IsWatched)
                        {
                            <Icon Glyph="Icons.Watched" Class="video-badge" title="Watched" />
                        }
                        @{
                            var dl = DownloadNotification(item.ApiVideo.Id);
                        }
                        @if (dl != null && dl.Progress.HasValue)
                        {
                            // Actively downloading: live pie, with the "downloaded" glyph beneath it so it
                            // reads as "on its way — watchable soon", not just an anonymous spinner.
                            <span class="video-badge-download">
                                <span class="video-badge video-pie"
                                      style="@PieStyle(dl.Progress)" title="@PieTitle(dl.Progress)"></span>
                                <Icon Glyph="Icons.Downloaded" Class="video-badge video-badge-under-pie" title="Downloading" />
                            </span>
                        }
                        else if (dl != null)
                        {
                            // Queued (ongoing but no progress yet) — a distinct waiting icon, not the pie.
                            <Icon Glyph="Icons.DownloadQueued" Class="video-badge" title="Queued for download" />
                        }
                        else if (item.ApiVideo.DeleteScheduledAt.HasValue)
                        {
                            <Icon Glyph="Icons.PendingDelete" Class="video-badge video-badge-delete"
                                  title="@DeletionTooltip(item.ApiVideo)" />
                        }
                        else if (item.ApiVideo.IsDownloaded)
                        {
                            <Icon Glyph="Icons.Downloaded" Class="video-badge" title="Downloaded" />
                        }
                    </div>
                    @if (item.ApiVideo.Duration.HasValue)
                    {
                        <div class="video-badges-bottom">
                            <span class="video-badge video-badge-duration">@item.ApiVideo.Duration.Value.ToDurationString()</span>
                        </div>
                    }
                    @if (!item.ApiVideo.IsWatched && item.ApiVideo.PlaybackPositionSeconds >= Regard.Model.PlaybackConstants.MinInProgressSeconds && item.ApiVideo.Duration > 0)
                    {
                        <div class="video-progress">
                            <div class="video-progress-fill"
                                 style="width:@(System.Math.Min(100, item.ApiVideo.PlaybackPositionSeconds.Value * 100 / item.ApiVideo.Duration.Value))%"></div>
                        </div>
                    }
                </NavLink>
            </div>
            <div class="video-body">
                <div class="video-text">
                    <NavLink href="@($"/watch/{item.ApiVideo.Id}")">
                        <h3>@item.Name</h3>
                        <small class="text-muted">
                            @if (item.ApiVideo.UploaderName != null)
                            {
                                <span>@item.ApiVideo.UploaderName</span>
                                <span>&nbsp;&#x2022;&nbsp;</span>
                            }
                            @if (item.ApiVideo.Views.HasValue)
                            {
                                <span>@item.ApiVideo.Views.Value.ToMetric(decimals: 1) views</span>
                                <span>&nbsp;&#x2022;&nbsp;</span>
                            }
                            @if (item.ApiVideo.IsEnriched)
                            {
                                <span>@item.ApiVideo.Published.ToLocalTime().Humanize()</span>
                            }
                        </small>
                    </NavLink>
                </div>
                <div class="video-menu">
                    <button @ref="item.MenuLink" class="button-undecorated video-menu-link"
                            @onclick="() => OnVideoShowContextMenu(item)">
                        <Icon Glyph="Icons.Menu" />
                    </button>
                    <Menu AttachTo="item.MenuLink" @bind-IsVisible="item.IsContextMenuVisible">
                        @if (item.ApiVideo.IsWatched)
                        {
                            <MenuItem Click="() => OnVideoMarkNotWatched(item)">Mark not watched</MenuItem>
                        }
                        else 
                        { 
                            <MenuItem Click="() => OnVideoMarkWatched(item)">Mark watched</MenuItem>
                        }
                        @if (item.ApiVideo.IsDownloaded)
                        {
                            <MenuItem Click="() => OnVideoDeleteFiles(item)">Delete downloaded files</MenuItem>
                            @if (item.ApiVideo.DeleteScheduledAt.HasValue)
                            {
                                <MenuItem Click="() => OnVideoUnmarkForDeletion(item)">Unmark for deletion</MenuItem>
                            }
                            else
                            {
                                <MenuItem Click="() => OnVideoMarkForDeletion(item)">Mark for deletion</MenuItem>
                            }
                        }
                        else
                        {
                            <MenuItem Click="() => OnVideoDownload(item)">Download</MenuItem>
                        }
                    </Menu>
                </div>
            </div>
        </div>
    </ItemTemplate>
</ListView>
}

@if (totalVideoCount > videosPerPage)
{
    <PaginationControl Page="page"
                       PageChanged="SetPage"
                       ItemCount="totalVideoCount"
                       ItemsPerPage="videosPerPage" />
}
</div>