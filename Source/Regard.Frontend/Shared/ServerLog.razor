@* Shell for the admin-only server log area. Nests a TabView the way Admin.razor does for
   Server/Users, so the three log sources sit side by side rather than as three top-level Settings
   tabs. Each source is its own component and loads only when its tab is first shown. *@

<div class="server-log-page">
    <TabView>
        <TabPage>
            <Title>Application</Title>
            <Content>
                <AppLogList />
            </Content>
        </TabPage>
        <TabPage>
            <Title>yt-dlp</Title>
            <Content>
                <YtdlLogList />
            </Content>
        </TabPage>
        <TabPage>
            <Title>Messages</Title>
            <Content>
                <UserMessageList />
            </Content>
        </TabPage>
    </TabView>
</div>
