<EditForm Model="Request"
          OnValidSubmit="OnSubmit"
          class="form-horizontal">

    <p class="text-muted">
        Enter your username. If an account exists, we'll send password reset instructions to its email
        address. If email isn't set up on this server, an administrator can retrieve the reset link from
        the server log.
    </p>

    <RgInputText Id="forgot_username"
                 @bind-Value="Request.Username"
                 Label="Username:"
                 Required="true"
                 ValidationFor="() => Request.Username"
                 autocapitalize="none" />

    <div class="form-group">
        <DataAnnotationsValidator />
        <Microsoft.AspNetCore.Components.Forms.ValidationSummary />
        @if (message != null)
        {
            <p class="fg-success">@message</p>
        }
    </div>

    <div class="row">
        <div class="col-xs-12 row">
            <button class="primary ml-auto" type="submit" disabled="@SubmitClicked">@SubmitText</button>
        </div>
    </div>

</EditForm>
