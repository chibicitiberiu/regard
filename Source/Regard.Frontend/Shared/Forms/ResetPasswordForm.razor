<EditForm Model="Request"
          OnValidSubmit="OnSubmit"
          class="form-horizontal">

    <RgInputText Id="reset_password"
                 @bind-Value="Request.Password1"
                 Label="New password:"
                 type="password"
                 Required="true"
                 ValidationFor="() => Request.Password1"
                 autocapitalize="none"
                 autocomplete="new-password" />

    <RgInputText Id="reset_password_confirm"
                 @bind-Value="Request.Password2"
                 Label="Confirm password:"
                 type="password"
                 Required="true"
                 ValidationFor="() => Request.Password2"
                 autocapitalize="none"
                 autocomplete="new-password" />

    <div class="form-group">
        <DataAnnotationsValidator />
        <Microsoft.AspNetCore.Components.Forms.ValidationSummary />
        @if (message != null)
        {
            <p class="@(succeeded ? "fg-success" : "fg-error")">@message</p>
        }
    </div>

    <div class="row">
        <div class="col-xs-12 row">
            @if (succeeded)
            {
                <a class="button primary ml-auto" href="/auth/login">Go to login</a>
            }
            else
            {
                <button class="primary ml-auto" type="submit" disabled="@SubmitClicked">@SubmitText</button>
            }
        </div>
    </div>

</EditForm>
