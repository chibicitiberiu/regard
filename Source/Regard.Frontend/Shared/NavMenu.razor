@using Regard.Common.API.Model
@using System.Linq

<nav class="navbar navbar-fixed-top">
    <NavLink class="navbar-brand nav-link logo-small" href="" Match="NavLinkMatch.All" @onclick="LogoClicked">
        Regard
    </NavLink>

    <AuthorizeView>
        <Authorized>
            <ul class="navbar-nav navbar-nav-right">
                <li class="nav-item" onclick="">

                    <a @ref="notificationsLink" href="#" class="nav-link notif-bell" @onclick="@ToggleNotificationsPanel" @onclick:preventDefault="true">
                        <Icon Glyph="Icons.NotificationsFull" />
                        @if (HaveNotifications)
                        {
                            <span class="notif-dot notif-dot--@Notifications.DotState.ToString().ToLowerInvariant()"></span>
                        }
                    </a>
                    <DropDownPanel @bind-IsVisible="NotificationsPanelVisible"
                                   AttachTo="notificationsLink"
                                   Placement="Popper.Placement.Bottom"
                                   Offset="15">
                        <div class="notifications-panel">
                            @if (Notifications.Notifications.Count == 0)
                            {
                                <div class="np-empty">Nothing happening right now.</div>
                            }
                            else
                            {
                                <div class="np-header">
                                    <span class="np-section-title">Notifications</span>
                                    <div class="np-header-actions">
                                        <a href="#" class="np-history" title="View job history"
                                           @onclick="OnHistoryClick" @onclick:preventDefault="true">
                                            <Icon Glyph="Icons.History" /> History
                                        </a>
                                        @if (Notifications.Notifications.Any(n => !n.Ongoing))
                                        {
                                            <button class="button-undecorated np-clear" @onclick="OnClearAll">Clear all</button>
                                        }
                                    </div>
                                </div>
                                <ListView Model="ApiNotification" ItemsSource="Notifications.Notifications" Class="np-list">
                                    <ItemTemplate Context="n">
                                        <div class="np-item np-item-@n.Severity.ToString().ToLowerInvariant() @(HasPrimaryAction(n) ? "np-clickable" : "")"
                                             @onclick="() => OnNotificationClick(n)">
                                            <div class="np-item-main">
                                                <div class="np-item-title">@n.Title</div>
                                                @if (!string.IsNullOrEmpty(n.Text))
                                                {
                                                    <div class="np-item-text">@n.Text</div>
                                                }
                                                @if (n.Progress.HasValue || n.Ongoing)
                                                {
                                                    <div class="progress-bar">
                                                        <div class="progress-bar-fill @(n.Progress.HasValue ? "" : "indeterminate")"
                                                             style="@ProgressWidth(n)"></div>
                                                    </div>
                                                }
                                            </div>
                                            <div class="np-item-actions">
                                                @if (n.Ongoing && n.Cancellable && n.JobId.HasValue)
                                                {
                                                    <button class="button-undecorated np-action" title="Cancel"
                                                            @onclick="() => OnCancel(n)" @onclick:stopPropagation="true">
                                                        <Icon Glyph="Icons.Close" />
                                                    </button>
                                                }
                                                @if (n.Severity == ApiNotificationSeverity.Error && n.VideoId.HasValue)
                                                {
                                                    <button class="button-undecorated np-action np-retry" title="Retry download"
                                                            @onclick="() => OnRetry(n)" @onclick:stopPropagation="true">
                                                        <Icon Glyph="Icons.Synchronize" /> Retry
                                                    </button>
                                                }
                                                @if (!n.Ongoing)
                                                {
                                                    <button class="button-undecorated np-action" title="Dismiss"
                                                            @onclick="() => OnDismiss(n)" @onclick:stopPropagation="true">
                                                        <Icon Glyph="Icons.Close" />
                                                    </button>
                                                }
                                            </div>
                                        </div>
                                    </ItemTemplate>
                                </ListView>
                            }
                        </div>
                    </DropDownPanel>
                </li>
                <li class="nav-item">
                    <a @ref="userLink" href="#" class="nav-link" @onclick="@ToggleUserPanel" @onclick:preventDefault="true">
                        <Icon Glyph="Icons.Profile" />
                    </a>
                    <DropDownPanel @bind-IsVisible="UserPanelVisible"
                                   AttachTo="userLink"
                                   Placement="Popper.Placement.Bottom"
                                   Offset="15">
                        <div class="user-panel">
                            @if (!string.IsNullOrEmpty(username))
                            {
                                <div class="user-panel-name">Signed in as <strong>@username</strong></div>
                            }
                            <button class="button-undecorated user-panel-logout" @onclick="Logout">
                                <Icon Glyph="Icons.SignOut" /> Log out
                            </button>
                        </div>
                    </DropDownPanel>
                </li>
                <li class="nav-item">
                    <NavLink class="nav-link" href="/settings" title="Settings">
                        <Icon Glyph="Icons.Settings" />
                    </NavLink>
                </li>
            </ul>
        </Authorized>
    </AuthorizeView>
</nav>
