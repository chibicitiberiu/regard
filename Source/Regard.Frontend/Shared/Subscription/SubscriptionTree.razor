<SortedTreeView @ref="treeView"
                Model="SubscriptionItemViewModelBase"
                TSortKey="string"
                SelectedItemChanged="OnSelectedItemChanged"
                EnableDragDrop="true"
                CanDrop="CanDropItem"
                ItemDropped="OnItemDropped">
    <HeaderContent>
        <div class="tree-item tree-item-home">
            <div class="tree-item-content @(isHomeActive ? "home-active" : "")" @onclick="OnHomeClicked">
                @* Placeholder chevron (hidden) so Home's icon lines up with the folder/subscription rows,
                   which each reserve space for an expand button. *@
                <button class="button-undecorated tree-item-expand-button v-hidden" tabindex="-1">
                    <Icon Glyph="Icons.ChevronDown" Class="tree-item-expand-icon" />
                </button>
                <div class="tree-subscription-icon"><Icon Glyph="Icons.Home" /></div>
                <div class="tree-subscription-name">Home</div>
            </div>
        </div>
    </HeaderContent>
    <ItemTemplate Context="item">
        <button class="button-undecorated tree-item-expand-button @CssUtils.BoolToClass(item.Children.Count == 0, "v-hidden")"
                @onclick="() => OnExpandToggle(item)" @onclick:stopPropagation="true">
            <Icon Glyph="Icons.ChevronDown" Class="tree-item-expand-icon" />
        </button>
        <div class="tree-subscription-icon">
            @if (item.Data.ThumbnailUrl != null)
            {
                <img src="@item.Data.ThumbnailUrl" />
            }
            else
            {
                <Icon Glyph="item.Data.PlaceholderIcon" />
            }
        </div>
        <div class="tree-subscription-name">
            @item.Data.Name
        </div>
        <button @ref="item.Data.ContextMenuLinkReference"
                class="button-undecorated tree-subscription-menu"
                @onclick="() => OnShowMenu(item)" @onclick:stopPropagation="true">
            <Icon Glyph="Icons.Menu" />
        </button>
        <Menu AttachTo="item.Data.ContextMenuLinkReference" @bind-IsVisible="item.Data.IsContextMenuVisible">
            <MenuItem Click="() => OnEditItem(item)">Edit</MenuItem>
            <MenuItem Click="() => OnMoveItem(item)">Move to folder…</MenuItem>
            <MenuItem Click="() => OnSynchronizeItem(item)">Synchronize</MenuItem>
            @if (item.Data is SubscriptionViewModel)
            {
                <MenuItem Click="() => OnFetchSubtitlesItem(item)">Fetch missing subtitles</MenuItem>
            }
            <MenuItem Click="() => OnDeleteItem(item)">Delete</MenuItem>
        </Menu>
    </ItemTemplate>
</SortedTreeView>

@if (loaded && AppState.Subscriptions.Count == 0 && AppState.Folders.Count == 0)
{
    <div class="empty-state tree-empty">
        <p>No subscriptions yet.</p>
        <p>Use <Icon Glyph="Icons.Add" /> above to add your first one.</p>
    </div>
}

@* Reports what the bulk subtitle fetch actually queued. Without it the action looks like it did
   nothing, since the work happens in background jobs. *@
<Dialog @ref="subtitleDialog"
        PrimaryButtonCaption="OK"
        Caption="Fetch missing subtitles">
    <div class="form-group">
        @subtitleResultMessage
    </div>
</Dialog>

<Dialog @ref="deleteDialog"
        PrimaryButtonCaption="Delete"
        SecondaryButtonCaption="Cancel"
        Caption="Delete?">

    <div class="form-group">
        Are you sure you want to delete @(deleteFolder ? "folder" : "subscription") <em>@deleteItemName</em>?
        <br />
        This operation cannot be undone.
    </div>

    @if (deleteFolder)
    {
        <div class="form-group row">
            <div class="col-xs-12">
                <input id="chk_delete_recursive" type="checkbox"
                       @bind-value="deleteRecursive" />
                <label for="chk_delete_recursive">Delete all subscriptions and subfolders</label>
            </div>
        </div>
    }
    <div class="form-group row">
        <div class="col-xs-12">
            <input id="chk_delete_files" type="checkbox"
                   @bind-value="deleteDownloadedFiles"
                   disabled="@(deleteFolder && !deleteRecursive)" />
            <label for="chk_delete_files">Delete all downloaded videos</label>
        </div>
    </div>

</Dialog>

<Dialog @ref="moveDialog"
        PrimaryButtonCaption="Move"
        SecondaryButtonCaption="Cancel"
        Caption="Move to folder">

    <div class="form-group">
        Move <em>@moveItemName</em> to:
    </div>
    <div class="form-group">
        <FolderSelect Id="move_target_folder"
                      @bind-Value="moveTargetFolderId"
                      ExcludeSubtreeRootId="moveExcludeSubtreeRootId"
                      Label="Destination folder:"
                      Required="false" />
    </div>

</Dialog>
