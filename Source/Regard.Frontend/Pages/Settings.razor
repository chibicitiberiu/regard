@page "/settings"
@attribute [Authorize]
@using Regard.Common.API.Settings

<div class="settings-page">
    <h2>Settings</h2>

    <TabView ActiveTab="@TabQuery">
        <TabPage>
            <Title>Downloads</Title>
            <Content>
                @if (loading)
                {
                    <p>Loading…</p>
                }
                else
                {
                    @if (usage != null)
                    {
                        <section class="settings-section">
                            <h3>Storage &amp; quota</h3>
                            <div class="quota-summary">
                                <div>
                                    <strong>@usage.VideoCount</strong>@(usage.VideoQuota.HasValue
                                        ? $" of {usage.VideoQuota.Value} videos"
                                        : (usage.VideoCount == 1 ? " video (no limit)" : " videos (no limit)"))
                                </div>
                                <div>
                                    <strong>@FormatSize(usage.UsedBytes)</strong>@(usage.StorageQuotaBytes.HasValue ? $" of {FormatSize(usage.StorageQuotaBytes.Value)}" : "") used@(usage.StorageQuotaBytes.HasValue ? "" : " (no limit)")
                                </div>
                                @if (usage.StorageQuotaBytes.HasValue)
                                {
                                    <div class="progress-bar quota-bar">
                                        <div class="progress-bar-fill" style="width:@(StoragePercent)%"></div>
                                    </div>
                                }
                            </div>
                        </section>
                    }

                    @if (throttle != null && throttle.Enabled)
                    {
                        <section class="settings-section">
                            <h3>Download pacing</h3>
                            <p>
                                Downloads are paced to look like a real viewer and avoid rate limits:
                                about one every @throttle.DownloadMinSeconds–@throttle.DownloadMaxSeconds s per site@(throttle.MaxPerDay > 0 ? $", up to {throttle.MaxPerDay}/day" : "").
                                @(throttle.CookiesConfigured ? "Cookies are configured." : "No cookies configured — some videos may not download until an admin adds them.")
                            </p>
                            @if (throttle.Hosts != null && throttle.Hosts.Count > 0)
                            {
                                <ul class="throttle-hosts">
                                    @foreach (var h in throttle.Hosts)
                                    {
                                        <li>@h.Host — @h.InFlight downloading, @h.Queued queued, @h.UsedLastDay today</li>
                                    }
                                </ul>
                            }
                        </section>
                    }

                    <section class="settings-section">
                        <h3>Downloads</h3>

            <div class="form-group row">
                <label class="col-xs-4 col-form-label">Maximum resolution:</label>
                <div class="col-xs-8">
                    <select class="form-control" @bind="MaxResolutionStr">
                        <option value="">Default</option>
                        <option value="0">Unlimited</option>
                        <option value="2160">2160p (4K)</option>
                        <option value="1440">1440p</option>
                        <option value="1080">1080p</option>
                        <option value="720">720p</option>
                        <option value="480">480p</option>
                        <option value="360">360p</option>
                    </select>
                </div>
            </div>

            <div class="form-group row">
                <label class="col-xs-4 col-form-label">Exclude video codecs:</label>
                <div class="col-xs-8">
                    <label class="inline-check">
                        <input type="checkbox" @bind="OverrideVideoCodecs" /> Override default
                    </label>
                    @if (OverrideVideoCodecs)
                    {
                        <div class="codec-list">
                            @foreach (var c in VideoCodecOptions)
                            {
                                <label class="inline-check" @key="c.Token">
                                    <input type="checkbox" checked="@videoCodecs.Contains(c.Token)"
                                           @onchange="e => ToggleCodec(videoCodecs, c.Token, e)" />
                                    @c.Label
                                </label>
                            }
                        </div>
                    }
                </div>
            </div>

            <div class="form-group row">
                <label class="col-xs-4 col-form-label">Exclude audio codecs:</label>
                <div class="col-xs-8">
                    <label class="inline-check">
                        <input type="checkbox" @bind="OverrideAudioCodecs" /> Override default
                    </label>
                    @if (OverrideAudioCodecs)
                    {
                        <div class="codec-list">
                            @foreach (var c in AudioCodecOptions)
                            {
                                <label class="inline-check" @key="c.Token">
                                    <input type="checkbox" checked="@audioCodecs.Contains(c.Token)"
                                           @onchange="e => ToggleCodec(audioCodecs, c.Token, e)" />
                                    @c.Label
                                </label>
                            }
                        </div>
                    }
                </div>
            </div>

            <div class="form-group row">
                <label class="col-xs-4 col-form-label">Convert (transcode) to:</label>
                <div class="col-xs-8">
                    <select class="form-control" @bind="TranscodeVideoStr">
                        <option value="">Default</option>
                        <option value="off">Off (keep original)</option>
                        <option value="mp4">mp4</option>
                        <option value="mkv">mkv</option>
                        <option value="webm">webm</option>
                    </select>
                    @if (IsTranscodeTarget)
                    {
                        <div class="transcode-mode">
                            <label class="inline-check">
                                <input type="radio" name="tmode" checked="@(TranscodeModeVal == "remux")"
                                       @onchange="@(() => TranscodeModeVal = "remux")" />
                                Remux (lossless, fast)
                            </label>
                            <label class="inline-check">
                                <input type="radio" name="tmode" checked="@(TranscodeModeVal == "recode")"
                                       @onchange="@(() => TranscodeModeVal = "recode")" />
                                Re-encode (slow, lossy)
                            </label>
                            @if (TranscodeModeVal == "recode")
                            {
                                <p class="fg-error transcode-warning">
                                    Re-encoding runs ffmpeg on every download — CPU-heavy and lossy.
                                    Remux only changes the container and is near-instant.
                                </p>
                            }
                        </div>
                    }
                </div>
            </div>

            <div class="form-group row">
                <label class="col-xs-4 col-form-label">Embed external players:</label>
                <div class="col-xs-8">
                    <select class="form-control" @bind="AllowEmbeddingStr">
                        <option value="">Default (off)</option>
                        <option value="on">Allow embedding</option>
                        <option value="off">Never embed</option>
                    </select>
                    <small class="text-muted">
                        When allowed, a video you haven't downloaded plays in its source site's player
                        (e.g. YouTube) on the watch page. Off keeps things private — you get a
                        "Download" and "Watch on the original site" prompt instead.
                    </small>
                </div>
            </div>

            <div class="form-group row">
                <label class="col-xs-4 col-form-label">Download subtitles:</label>
                <div class="col-xs-8">
                    <select class="form-control" @bind="SubtitlesStr">
                        <option value="">Default (off)</option>
                        <option value="on">On</option>
                        <option value="off">Off</option>
                    </select>
                    @if (ShowSubtitleOptions)
                    {
                        <div class="subtitle-suboptions">
                            <label class="inline-check">
                                <input type="checkbox" @bind="IncludeAutoSub" /> Include auto-generated captions
                            </label>

                            <div class="form-group row">
                                <label class="col-xs-4 col-form-label">Languages:</label>
                                <div class="col-xs-8">
                                    <select class="form-control" @bind="SubLangMode">
                                        <option value="specific">Specific languages</option>
                                        <option value="all">All available</option>
                                    </select>
                                    @if (SubLangMode == "specific")
                                    {
                                        <input class="form-control" @bind="SubLangStr"
                                               placeholder="en,en-US,es" autocapitalize="none" />
                                        <small class="text-muted">Comma-separated yt-dlp language codes.</small>
                                    }
                                </div>
                            </div>

                            <div class="form-group row">
                                <label class="col-xs-4 col-form-label">Format:</label>
                                <div class="col-xs-8">
                                    <select class="form-control" @bind="SubFormatStr">
                                        <option value="">Default (best)</option>
                                        <option value="best">Best</option>
                                        <option value="srt">SRT</option>
                                        <option value="vtt">VTT</option>
                                        <option value="ass">ASS</option>
                                    </select>
                                </div>
                            </div>
                        </div>
                    }
                </div>
            </div>

            <div class="form-group row">
                <label class="col-xs-4 col-form-label">SponsorBlock:</label>
                <div class="col-xs-8">
                    <SponsorBlockEditor @bind-Value="SponsorblockActions" />
                </div>
            </div>

            <div class="form-group row">
                <label class="col-xs-4 col-form-label">Download location:</label>
                <div class="col-xs-8">
                    <input class="form-control" @bind="DownloadPath" @bind:event="oninput"
                           placeholder="(default template)" autocapitalize="none" />
                    <small class="text-muted">
                        Path and filename template for downloads (yt-dlp <code>-o</code>). Available tokens:
                        <code>@("{DownloadDirectory}")</code> (your download root),
                        <code>@("{FolderPath}")</code> (the subscription's folder tree),
                        <code>@("{Subscription.Name}")</code>,
                        <code>@("{EpisodeCode}")</code> (Jellyfin-style SxxExx), and
                        <code>@("{Video.Name}")</code>. Other <code>@("{Video.*}")</code> /
                        <code>@("{Subscription.*}")</code> properties and <code>@("{Env[VAR]}")</code> also
                        work. Leave blank to inherit. An unknown token makes the download fail, so check the
                        example below.
                    </small>
                    <div class="pattern-preview">Example: <code>@PatternPreview</code></div>
                </div>
            </div>

            <details class="advanced">
                <summary>Advanced</summary>

                <div class="form-group row">
                    <label class="col-xs-4 col-form-label">Raw format override:</label>
                    <div class="col-xs-8">
                        <input class="form-control" @bind="RawFormatOverride"
                               placeholder="(compose from the options above)" autocapitalize="none" />
                        <small class="text-muted">When set, overrides the resolution/codec options above (yt-dlp <code>-f</code> syntax).</small>
                    </div>
                </div>

                <div class="form-group row">
                    <label class="col-xs-4 col-form-label">Merge container:</label>
                    <div class="col-xs-8">
                        <select class="form-control" @bind="MergeOutputFormat">
                            <option value="">Default</option>
                            <option value="mp4">mp4</option>
                            <option value="mkv">mkv</option>
                            <option value="webm">webm</option>
                        </select>
                    </div>
                </div>
            </details>

            <div class="form-group row">
                <div class="col-xs-12 row">
                    <span class="@(saved ? "fg-success" : "fg-error")">@statusMessage</span>
                    <button class="primary ml-auto" @onclick="OnSave" disabled="@saving">Save</button>
                </div>
            </div>
                    </section>
                }
            </Content>
        </TabPage>
        <TabPage Name="joblog">
            <Title>Job Log</Title>
            <Content>
                <JobLog />
            </Content>
        </TabPage>
        <AuthorizeView Roles="admin" Context="adminCtx">
            <TabPage Name="admin">
                <Title>Administration</Title>
                <Content>
                    <Admin />
                </Content>
            </TabPage>
        </AuthorizeView>
    </TabView>
</div>
