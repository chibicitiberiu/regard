@page "/auth/register"
@layout AuthLayout
@inject AppController appCtrl

<SetupCard Title="Create your account" Eyebrow="Sign up">
    <RegisterForm SubmitText="Register" Registered="OnFormCompleted" />
</SetupCard>

@code {
    private void OnFormCompleted()
    {
        appCtrl.NavigateToFromUrl();
    }
}
