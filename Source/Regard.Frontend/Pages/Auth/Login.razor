@page "/auth/login"
@layout AuthLayout
@inject AppController appCtrl

<SetupCard Title="Welcome back" Eyebrow="Sign in">
    <LoginForm SubmitText="Login" LoggedIn="OnFormCompleted" />
</SetupCard>

@code {

    private void OnFormCompleted()
    {
        appCtrl.NavigateToFromUrl();
        StateHasChanged();
    }
}
