@page "/auth/reset-password"
@layout AuthLayout
@using Microsoft.AspNetCore.WebUtilities
@inject NavigationManager Nav

<SetupCard Title="Reset password" Eyebrow="Recover">
    @if (hasLink)
    {
        <ResetPasswordForm Username="@username" Token="@token" />
    }
    else
    {
        <p class="fg-error">
            This reset link is invalid or missing its token. Request a new one from the
            <a href="/auth/forgot-password">forgot password</a> page.
        </p>
    }
</SetupCard>

@code {
    private string username;
    private string token;
    private bool hasLink;

    protected override void OnInitialized()
    {
        // ParseNullableQuery decodes each value exactly once — do NOT decode the token again here,
        // or '+'/'=' in it would be corrupted. It then travels to the backend in the POST body.
        var uri = new Uri(Nav.Uri);
        var query = QueryHelpers.ParseNullableQuery(uri.Query);

        if (query != null
            && query.TryGetValue("username", out var u)
            && query.TryGetValue("token", out var t)
            && !string.IsNullOrWhiteSpace(u)
            && !string.IsNullOrWhiteSpace(t))
        {
            username = u;
            token = t;
            hasLink = true;
        }
    }
}
