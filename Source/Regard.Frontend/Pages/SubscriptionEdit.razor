@page "/subscription/edit/{subscriptionId:int}"

<div class="settings-page">
<h2>Edit subscription</h2>
<EditForm Model="Request"
          OnValidSubmit="OnSubmit">
<section class="settings-section">

    <RgInputText Id="subscription_name"
                 @bind-Value="Request.Name"
                 Label="Name:"
                 Required="true"
                 ValidationFor="() => Request.Name"
                 autocapitalize="none"
                 autofocus />

    <RgFieldWrapper Id="subscription_icon" Label="Icon:" Required="false">
        <Field>
            <div class="sub-icon-field">
                <img class="sub-icon-preview" src="@IconPreviewUrl" alt="" />
                <InputFile OnChange="OnIconFile" accept="image/png,image/jpeg,image/gif,image/webp" />
            </div>
        </Field>
        <HelpText>PNG, JPG, GIF or WebP, up to 5 MB. Replaces the channel/provider icon.</HelpText>
    </RgFieldWrapper>

    <RgInputTextArea Id="subscription_desc"
                     @bind-Value="Request.Description"
                     Label="Description:"
                     Required="false"
                     ValidationFor="() => Request.Description"
                     rows="12"
                     autocapitalize="none"
                     autofocus />

    <FolderSelect Id="subscription_parent"
                  @bind-Value="Request.ParentFolderId"
                  Label="Parent folder:"
                  Required="false" />

    <RgSimpleInputSelect Id="subscription_autoDownload"
                         TKey="bool?"
                         @bind-Value="Request.AutoDownload"
                         DefaultValueText="@AutoDownloadDefaultText"
                         Label="Automatic download: "
                         Required="false" />

    <RgInputText Id="subscription_downloadMaxCount"
                 @bind-Value="DownloadMaxCountStr"
                 Label="Download maximum count:"
                 Required="false"
                 ValidationFor="() => DownloadMaxCountStr"
                 autocapitalize="none"
                 autofocus />

    <!--<RgFieldWrapper Id="subscription_downloadMaxCount"
                    Label="Download maximum count:"
                    Required="false">
        <Field>
            <InputNumber id="subscription_downloadMaxCount"
                         class="form-control"
                         @bind-Value="Request.DownloadMaxCount"
                         required="false" />
        </Field>-->
        @*<ValidationText>
                <ValidationMessage For="Request.DownloadMaxCount" />
            </ValidationText>*@
    <!--</RgFieldWrapper>-->

    <RgSimpleInputSelect Id="subscription_downloadOrder"
                         TKey="Regard.Model.VideoOrder?"
                         @bind-Value="Request.DownloadOrder"
                         DefaultValueText="@DownloadOrderDefaultText"
                         Label="Download order: "
                         Required="false" />

    <RgSimpleInputSelect Id="subscription_deleteWatched"
                         TKey="bool?"
                         @bind-Value="Request.DeleteWatched"
                         DefaultValueText="@DeleteWatchedDefaultText"
                         Label="Delete files when watched: "
                         Required="false" />

    <RgInputText Id="subscription_deleteGracePeriod"
                 @bind-Value="DeleteGracePeriodStr"
                 Label="Delete grace period (minutes, 0 = immediate):"
                 Required="false"
                 ValidationFor="() => DeleteGracePeriodStr"
                 autocapitalize="none" />

    <RgSimpleInputSelect Id="subscription_markDeletedAsWatched"
                         TKey="bool?"
                         @bind-Value="Request.MarkDeletedAsWatched"
                         DefaultValueText="@MarkDeletedAsWatchedDefaultText"
                         Label="Mark watched when files deleted: "
                         Required="false" />

    <RgInputText Id="subscription_downloadPath"
                 @bind-Value="Request.DownloadPath"
                 BindOn="BindEvent.OnInput"
                 Label="Download path:"
                 Required="false"
                 ValidationFor="() => Request.DownloadPath"
                 autocapitalize="none"
                 autofocus>
        <HelpText>
            Path and filename template for downloads (yt-dlp <code>-o</code>). Tokens:
            <code>@("{DownloadDirectory}")</code>, <code>@("{FolderPath}")</code>,
            <code>@("{Subscription.Name}")</code>, <code>@("{EpisodeCode}")</code> (SxxExx),
            <code>@("{Video.Name}")</code>; other <code>@("{Video.*}")</code> /
            <code>@("{Subscription.*}")</code> properties and <code>@("{Env[VAR]}")</code> also work.
            Leave blank to inherit. An unknown token makes the download fail.
            <div class="pattern-preview">Example: <code>@PatternPreview</code></div>
        </HelpText>
    </RgInputText>

    <RgFieldWrapper Id="subscription_writeSubtitles" Label="Download subtitles:" Required="false">
        <Field>
            <select id="subscription_writeSubtitles" class="form-control" @bind="WriteSubtitlesStr">
                <option value="">(inherit)</option>
                <option value="on">On</option>
                <option value="off">Off</option>
            </select>
        </Field>
    </RgFieldWrapper>

    <RgFieldWrapper Id="subscription_writeAutoSub" Label="Include auto-generated captions:" Required="false">
        <Field>
            <select id="subscription_writeAutoSub" class="form-control" @bind="WriteAutoSubStr">
                <option value="">(inherit)</option>
                <option value="on">On</option>
                <option value="off">Off</option>
            </select>
        </Field>
    </RgFieldWrapper>

    <RgFieldWrapper Id="subscription_allSubs" Label="Download all subtitle languages:" Required="false">
        <Field>
            <select id="subscription_allSubs" class="form-control" @bind="AllSubsStr">
                <option value="">(inherit)</option>
                <option value="on">On</option>
                <option value="off">Off</option>
            </select>
        </Field>
    </RgFieldWrapper>

    <RgInputText Id="subscription_subLang"
                 @bind-Value="Request.SubLang"
                 Label="Subtitle languages:"
                 Required="false"
                 ValidationFor="() => Request.SubLang"
                 placeholder="en,en-US,es"
                 autocapitalize="none" />

    <RgInputText Id="subscription_subFormat"
                 @bind-Value="Request.SubFormat"
                 Label="Subtitle format:"
                 Required="false"
                 ValidationFor="() => Request.SubFormat"
                 placeholder="best / srt / vtt / ass"
                 autocapitalize="none" />

    <RgFieldWrapper Id="subscription_sponsorblock" Label="SponsorBlock:" Required="false">
        <Field>
            <SponsorBlockEditor @bind-Value="Request.SponsorblockActions" AllowInherit="true" />
        </Field>
    </RgFieldWrapper>

    <RgFieldWrapper Id="subscription_includeShorts" Label="Include Shorts:" Required="false">
        <Field>
            <select id="subscription_includeShorts" class="form-control" @bind="IncludeShortsStr">
                <option value="">@(IncludeShortsDefaultText is null ? "(inherit)" : $"Default ({IncludeShortsDefaultText})")</option>
                <option value="on">On</option>
                <option value="off">Off</option>
            </select>
        </Field>
        <HelpText>
            Applied while syncing, so excluded Shorts never enter the library. Turning this back on picks
            them up again on the next sync; turning it off leaves Shorts already stored in place.
        </HelpText>
    </RgFieldWrapper>

    <RgFieldWrapper Id="subscription_includeMembersOnly" Label="Include members-only videos:" Required="false">
        <Field>
            <select id="subscription_includeMembersOnly" class="form-control" @bind="IncludeMembersOnlyStr">
                <option value="">@(IncludeMembersOnlyDefaultText is null ? "(inherit)" : $"Default ({IncludeMembersOnlyDefaultText})")</option>
                <option value="on">On</option>
                <option value="off">Off</option>
            </select>
        </Field>
        <HelpText>
            Downloading these needs a channel membership in your cookies.txt. Without one they can be
            listed but never fetched, which is why they're left out by default.
        </HelpText>
    </RgFieldWrapper>

    <RgFieldWrapper Id="subscription_publishedAfter" Label="Published after:" Required="false">
        <Field>
            <input id="subscription_publishedAfter" type="date" class="form-control" @bind="PublishedAfterDate" />
        </Field>
        <HelpText>Only auto-download videos published on or after this date. Leave blank for no limit.</HelpText>
    </RgFieldWrapper>

    <RgFieldWrapper Id="subscription_publishedBefore" Label="Published before:" Required="false">
        <Field>
            <input id="subscription_publishedBefore" type="date" class="form-control" @bind="PublishedBeforeDate" />
        </Field>
        <HelpText>
            Only auto-download videos published on or before this date (the whole day counts). Leave blank
            for no limit. Neither date affects a download you start yourself.
        </HelpText>
    </RgFieldWrapper>

    <div class="form-group row">
        <div class="col-xs-3">
            <label class="col-form-label">Filters:</label>
        </div>
        <div class="col-xs-9">
            @foreach (var f in Request.Filters)
            {
                <div class="row" @key="f" style="margin-bottom: .5rem;">
                    <div class="col-xs-4">
                        <select class="form-control" @bind="f.Action">
                            <option value="Include">Include</option>
                            <option value="Exclude">Exclude</option>
                        </select>
                    </div>
                    <div class="col-xs-7">
                        <input class="form-control" placeholder="regex (matched on title, case-insensitive)"
                               @bind="f.Pattern" @bind:event="oninput" autocapitalize="none" />
                    </div>
                    <div class="col-xs-1">
                        <button type="button" class="button-transparent" title="Remove"
                                @onclick="@(() => Request.Filters.Remove(f))">
                            <Icon Glyph="Icons.Close" />
                        </button>
                    </div>
                </div>
            }
            <div class="row">
                <button type="button" class="secondary" @onclick="AddFilter"><Icon Glyph="Icons.Add" /> Add</button>
                <button type="button" class="secondary" style="margin-left: .5rem;" @onclick="ShowPreview">Preview</button>
            </div>
        </div>
    </div>

    <div class="form-group row">
        <div class="col-xs-12 fg-error">
            @ValidationMessage
        </div>
    </div>

    <div class="row">
        <div class="col-xs-12 row">
            <button class="primary ml-auto" type="submit" disabled="@(!SubmitEnabled)">Save</button>
        </div>
    </div>

</section>
</EditForm>
</div>

<Modal @ref="previewModal">
    <Title>Filter preview</Title>
    <Body>
        <p>
            <span class="fg-success">Green</span> = passes filters,
            <span class="fg-error">red</span> = excluded by a title filter,
            <span class="fg-warning">amber</span> = outside the publish-date window.
            <Icon Glyph="Icons.Queued" /> would download next, <Icon Glyph="Icons.Downloaded" /> already downloaded.
            (Size limits aren't reflected here.)
        </p>
        @if (PreviewTruncated)
        {
            <p class="fg-error">Showing the first 500 videos.</p>
        }
        <div class="filter-preview">
            @foreach (var item in PreviewItems)
            {
                <div class="row">
                    <span style="width: 1.5rem; display: inline-block;">
                        @if (item.InWindow) { <Icon Glyph="Icons.Queued" title="Would download next" /> }
                    </span>
                    <span style="width: 1.5rem; display: inline-block;">
                        @if (item.IsDownloaded) { <Icon Glyph="Icons.Downloaded" title="Downloaded" /> }
                    </span>
                    @* Title filter wins the colour when both reject it: it's the rule the user is editing. *@
                    <span class="@(!item.PassesFilters ? "fg-error" : !item.PassesDateWindow ? "fg-warning" : "fg-success")"
                          title="@(!item.PassesFilters ? "Excluded by a title filter" : !item.PassesDateWindow ? "Outside the publish-date window" : null)">@item.Name</span>
                </div>
            }
        </div>
    </Body>
</Modal>