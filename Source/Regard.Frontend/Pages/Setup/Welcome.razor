@page "/setup/welcome"
@inject AppController appCtrl

<SetupCard Eyebrow="Setup · Step 1" Title="Welcome to Regard">
    <p>This wizard will guide you through setting up your Regard instance &mdash; it only takes a moment.</p>

    <button class="btn btn-primary" @onclick="GoNext" disabled="@NextClicked">Next</button>
</SetupCard>

@code {
    bool NextClicked { get; set; }

    private async Task GoNext()
    {
        NextClicked = true;
        await appCtrl.ContinueSetup();
    }
}
