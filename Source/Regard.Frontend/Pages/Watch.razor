@page "/watch/{videoId:int}"
@using Regard.Common.API.Model
@using Regard.Frontend.Utils

@if (errorMessage != null)
{
    <div class="alert-card fg-error">Error: @errorMessage</div>
}

@if (video != null)
{
    <div class="watch-layout">
        <div class="watch-main">
            <div class="watch-player">
                @if (video.IsDownloaded && !streamFailed)
                {
                    <Video @ref="playerRef"
                           ShowControls="true"
                           AutoPlay="true"
                           CrossOrigin="@(HasSubtitles ? "anonymous" : null)"
                           WatchedThreshold="0.9"
                           WatchedThresholdReached="OnMarkWatchedFromPlayback"
                           Ended="OnMarkWatchedFromPlayback"
                           SkipSegments="video.SponsorSegments"
                           PositionChanged="OnPositionReport"
                           StartPosition="@ResumeFromSeconds"
                           Error="e => OnStreamError()">
                        <source src="@videoStreamUri" type="@video.StreamMimeType"
                                @onerror="e => OnStreamError()" />
                        @* Every language is mounted up front so the browser puts its own CC control in
                           the player's toolbar next to play/volume/fullscreen. Mounting them costs
                           nothing: a track whose mode is "disabled" is never fetched, so the cues are
                           still pulled only when one is actually turned on. *@
                        @if (subtitleTrackUrls != null)
                        {
                            @foreach (var track in video.SubtitleTracks)
                            {
                                var t = track;
                                if (subtitleTrackUrls.TryGetValue(t.Lang, out var trackUrl))
                                {
                                    <track @key="@($"{VideoId}:{t.Lang}")"
                                           kind="subtitles"
                                           src="@trackUrl"
                                           srclang="@t.Lang"
                                           label="@t.Label" />
                                }
                            }
                        }
                    </Video>
                    @* No CC control of our own. Batch 4b added one because Chrome was filing captions
                       inside the "⋮" overflow menu with no way to promote it — but with the tracks
                       mounted up front the browser puts a captions button in its own control bar, so
                       ours was a second, differently-styled button doing the same job a few pixels
                       away. The native one lists our labels ("English (auto-generated)") because they
                       come from the <track label> attribute, and the tracks' change event still feeds
                       the remembered-language preference, so nothing was lost by dropping it. *@
                    @if (video.SponsorSegments != null && video.SponsorSegments.Count > 0)
                    {
                        <p class="watch-sponsorblock text-muted">
                            Skipping @video.SponsorSegments.Count SponsorBlock
                            segment@(video.SponsorSegments.Count == 1 ? "" : "s") &middot;
                            <a href="https://sponsor.ajay.app" target="_blank" rel="noopener noreferrer">SponsorBlock</a>
                        </p>
                    }
                }
                else if (video.EmbedUrl != null)
                {
                    <div class="watch-embed">
                        <iframe src="@video.EmbedUrl"
                                allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture; web-share"
                                allowfullscreen></iframe>
                    </div>
                }
                else
                {
                    <div class="watch-unavailable">
                        <div class="watch-unavailable-inner">
                            <Icon Glyph="@(streamFailed ? Icons.Error : Icons.NotDownloaded)" Class="watch-unavailable-glyph" />
                            <p class="watch-unavailable-title">@(streamFailed ? "This video couldn't be played" : "This video isn't downloaded")</p>
                            <p class="text-muted">
                                @if (streamFailed)
                                {
                                    <span>The downloaded file couldn't be loaded &mdash; it may have been moved or removed. Download it again, or watch it on the original site.</span>
                                }
                                else if (!embeddingAllowed)
                                {
                                    <span>Embedding external players is turned off. Download it, or watch it on the original site.</span>
                                }
                                else
                                {
                                    <span>This site can't be embedded here. Download it, or watch it on the original site.</span>
                                }
                            </p>
                            @* A download in flight for this video: show what it's actually doing rather
                               than a button stuck on "Queued…" until the file appears. Everything here
                               already streams over SignalR — this page just wasn't listening. *@
                            @if (DownloadNotification is ApiNotification dl)
                            {
                                <div class="watch-download-progress">
                                    <div class="watch-download-bar">
                                        <div class="watch-download-fill"
                                             style="width:@(((dl.Progress ?? 0f) * 100).ToString("0.#", System.Globalization.CultureInfo.InvariantCulture))%"></div>
                                    </div>
                                    <small class="text-muted">@(dl.Text ?? dl.Title)</small>
                                </div>
                            }
                            <div class="watch-unavailable-actions">
                                <button class="primary" @onclick="OnDownloadNow" disabled="@(downloadQueued || DownloadNotification != null)">
                                    @(DownloadNotification != null ? "Downloading…" : (downloadQueued ? "Queued…" : (streamFailed ? "Download again" : "Download now")))
                                </button>
                                @if (watchOnHost != null)
                                {
                                    <a class="watch-btn" href="@video.OriginalUrl" target="_blank" rel="noopener noreferrer">
                                        Watch on @watchOnHost
                                    </a>
                                }
                            </div>
                        </div>
                    </div>
                }
            </div>

            <div class="watch-info">
                <h1 class="watch-title">@video.Name</h1>

                <div class="watch-meta">
                    <div class="watch-meta-left">
                        @if (subscription?.ThumbnailUrl != null)
                        {
                            <img class="channel-icon" src="@subscription.ThumbnailUrl" alt="@video.UploaderName">
                        }
                        @* A plain link, deliberately: writing AppState.SelectedSubscription would ALSO
                           navigate (AppController listens for it), so doing both would navigate twice —
                           and it wouldn't highlight the tree anyway, since the highlight is the tree's
                           own SelectedItem. Falls back to plain text when the subscription fetch failed. *@
                        @if (subscription != null)
                        {
                            <a class="watch-uploader" href="@($"/subscription/{video.SubscriptionId}")"
                               title="@($"Go to {subscription.Name}")">@video.UploaderName</a>
                        }
                        else
                        {
                            <span class="watch-uploader">@video.UploaderName</span>
                        }
                    </div>
                    <div class="watch-meta-right text-muted">
                        @if (video.Views.HasValue)
                        {
                            <span>@video.Views.Value.ToMetric(decimals: 1) views</span>
                            <span class="dot">&#x2022;</span>
                        }
                        @if (video.IsEnriched)
                        {
                            <span>@video.Published.ToLocalTime().Humanize()</span>
                        }
                        @if (video.Duration.HasValue)
                        {
                            <span class="dot">&#x2022;</span>
                            <span>@video.Duration.Value.ToDurationString()</span>
                        }
                    </div>
                </div>

                @* Three independent gates. The like count comes from yt-dlp and stands on its own; the
                   dislike estimate and the RYD credit only appear when RYD actually supplied data. A
                   single combined gate would either hide the like count or credit RYD for a yt-dlp
                   number. *@
                @if (video.Likes.HasValue || DislikeEstimate.HasValue)
                {
                    <div class="watch-votes">
                        @if (video.Likes.HasValue)
                        {
                            <span class="watch-vote" title="Likes"><Icon Glyph="Icons.ThumbUp" Class="watch-vote-icon" /> @(((double)video.Likes.Value).ToMetric(decimals: 1))</span>
                        }
                        @if (DislikeEstimate.HasValue)
                        {
                            <span class="watch-vote" title="Dislikes (estimated)"><Icon Glyph="Icons.ThumbDown" Class="watch-vote-icon" /> @(((double)DislikeEstimate.Value).ToMetric(decimals: 1))</span>
                        }
                        @if (video.Rating.HasValue)
                        {
                            @* A liked ratio sits at 0.95-0.99 for almost every video, so rendering it as
                               five stars would read 5/5 everywhere and say nothing. A percentage is how
                               YouTube itself framed it and actually distinguishes videos. *@
                            <span class="watch-rating-value" title="Share of votes that are likes">@LikedPercent</span>
                            <span class="watch-votes-credit text-muted">
                                via <a href="https://returnyoutubedislike.com" target="_blank" rel="noopener noreferrer">Return YouTube Dislike</a>
                            </span>
                        }
                    </div>
                }

                <div class="watch-actions">
                    @if (!video.IsDownloaded)
                    {
                        <button class="watch-btn" @onclick="OnDownloadNow" disabled="@downloadQueued">
                            @(downloadQueued ? "Queued…" : "Download")
                        </button>
                    }
                    @if (video.IsWatched)
                    {
                        <button class="watch-btn" @onclick="OnMarkNotWatched">Mark not watched</button>
                    }
                    else
                    {
                        <button class="watch-btn" @onclick="OnMarkWatched">Mark watched</button>
                    }
                    @* Offered only when the video is downloaded and has no tracks: with subtitles already
                       present there is nothing to fetch, and the CC control in the player is the answer. *@
                    @if (video.IsDownloaded && !HasSubtitles)
                    {
                        <button class="watch-btn" @onclick="OnFetchSubtitles" disabled="@subtitleFetchQueued"
                                title="Download subtitles for this video without re-downloading the video itself">
                            @(subtitleFetchQueued ? "Fetching…" : "Fetch subtitles")
                        </button>
                    }
                    <button class="watch-btn" @onclick="OnRefreshMetadata" disabled="@metadataRefreshQueued"
                            title="Re-fetch the view count, likes, title and chapters for this video now">
                        @(metadataRefreshQueued ? "Refreshing…" : "Refresh metadata")
                    </button>
                    @* Same gating as the grid's context menu: only for a downloaded video, with
                       DeleteScheduledAt choosing which of the pair to offer. No local state flip — the
                       change feed carries DeleteScheduledAt, so the button repaints itself. *@
                    @if (video.IsDownloaded)
                    {
                        @if (video.DeleteScheduledAt.HasValue)
                        {
                            <button class="watch-btn" @onclick="OnUnmarkForDeletion" title="@DeletionTooltip">Unmark for deletion</button>
                        }
                        else
                        {
                            @* The label doesn't promise a countdown: the effective grace period isn't
                               known here (it's inherited, and the page doesn't request subscription
                               config), and with a grace of 0 the files go immediately. *@
                            <button class="watch-btn" @onclick="OnMarkForDeletion"
                                    title="Delete the downloaded files after the configured grace period — immediately if that's set to 0.">
                                Mark for deletion
                            </button>
                        }
                    }
                    @if (watchOnHost != null)
                    {
                        <a class="watch-btn" href="@video.OriginalUrl" target="_blank" rel="noopener noreferrer">Watch on @watchOnHost</a>
                    }
                </div>

                <div class="watch-description">
                    <DescriptionText Text="@video.Description"
                                     LinkifyYouTube="@LinkifyYouTube"
                                     TimestampsSeekable="@DescriptionSeekable"
                                     OnSeek="OnDescriptionSeek" />
                </div>
            </div>
        </div>

        <aside class="watch-upnext">
            @if (HasChapters)
            {
                <div class="watch-chapters">
                    <details open>
                        <summary>Chapters <span class="text-muted">(@video.Chapters.Count)</span></summary>
                        @if (!ChaptersSeekable)
                        {
                            <p class="watch-chapters-note text-muted">
                                @(video.SponsorsRemoved
                                    ? "Seeking is off for this file — SponsorBlock trimmed its timeline."
                                    : "Chapters are shown by the player here.")
                            </p>
                        }
                        <ol class="watch-chapter-list">
                            @for (int i = 0; i < video.Chapters.Count; i++)
                            {
                                var idx = i;
                                var ch = video.Chapters[idx];
                                <li class="watch-chapter @(idx == ActiveChapterIndex ? "active" : "")">
                                    <button type="button" class="watch-chapter-btn"
                                            disabled="@(!ChaptersSeekable)"
                                            @onclick="() => OnChapterClicked(ch)">
                                        <span class="watch-chapter-time">@FormatTimestamp(ch.Start)</span>
                                        <span class="watch-chapter-title">@ch.Title</span>
                                    </button>
                                </li>
                            }
                        </ol>
                    </details>
                </div>
            }
            <h3>Up next</h3>
            @if (upNext == null)
            {
                <p class="text-muted">Loading…</p>
            }
            else if (upNext.Count == 0)
            {
                <p class="text-muted">Nothing up next.</p>
            }
            else
            {
                @foreach (var v in upNext)
                {
                    <NavLink class="upnext-item" href="@($"/watch/{v.Id}")" @key="v.Id">
                        <div class="upnext-thumb">
                            <img src="@ThumbUrl(v)" alt="" />
                            @* Same badge vocabulary as the grid, so "already downloaded" reads the same
                               in both places. Wrapped in .video-badges because the sizing rules are
                               scoped as ".video-badges .video-badge". *@
                            <div class="video-badges">
                                @if (v.DeleteScheduledAt.HasValue)
                                {
                                    <Icon Glyph="Icons.PendingDelete" Class="video-badge" title="Marked for deletion" />
                                }
                                else if (v.IsDownloaded)
                                {
                                    <Icon Glyph="Icons.Downloaded" Class="video-badge" title="Downloaded" />
                                }
                            </div>
                            @if (v.Duration.HasValue)
                            {
                                <span class="upnext-duration">@v.Duration.Value.ToDurationString()</span>
                            }
                            @if (!v.IsWatched && v.PlaybackPositionSeconds >= Regard.Model.PlaybackConstants.MinInProgressSeconds && v.Duration > 0)
                            {
                                <div class="video-progress">
                                    <div class="video-progress-fill"
                                         style="width:@(System.Math.Min(100, v.PlaybackPositionSeconds.Value * 100 / v.Duration.Value))%"></div>
                                </div>
                            }
                        </div>
                        <div class="upnext-text">
                            <span class="upnext-title">@v.Name</span>
                            <small class="text-muted">@v.UploaderName</small>
                        </div>
                    </NavLink>
                }
            }
        </aside>
    </div>
}
