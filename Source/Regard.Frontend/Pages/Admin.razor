@* Embedded as the "Administration" tab inside Settings (gated there by <AuthorizeView Roles="admin">).
   Reachable at /settings?tab=admin; the old /admin route redirects there (AdminRedirect.razor). *@
@using Regard.Common.API.Admin

<div class="admin-page">
    <TabView>
        <TabPage>
            <Title>Server</Title>
            <Content>
                @if (loadingServer)
                {
                    <p>Loading…</p>
                }
                else
                {
                    <section class="settings-section">
                        <h3>Registration</h3>
                        <div class="form-group row">
                            <label class="col-xs-4 col-form-label">Allow new sign-ups:</label>
                            <div class="col-xs-8">
                                <label class="inline-check">
                                    <input type="checkbox" @bind="AllowRegistrations" /> Users can register themselves
                                </label>
                            </div>
                        </div>
                    </section>

                    <section class="settings-section">
                        <h3>External services</h3>
                        <div class="form-group row">
                            <label class="col-xs-4 col-form-label">Return YouTube Dislike:</label>
                            <div class="col-xs-8">
                                <label class="inline-check">
                                    <input type="checkbox" @bind="ReturnYouTubeDislikeEnabled" />
                                    Show dislike counts on the watch page
                                </label>
                                <small class="text-muted">
                                    YouTube stopped publishing dislike counts in 2021, so these come from
                                    <a href="https://returnyoutubedislike.com" target="_blank" rel="noopener noreferrer">returnyoutubedislike.com</a>.
                                    Turning this on sends each watched video's id to that service, and
                                    their limits (100/min, 10k/day) are shared by everyone on this server.
                                    With it off, the watch page shows a like count but no ratio.
                                </small>
                            </div>
                        </div>
                    </section>

                    <section class="settings-section">
                        <h3>Default per-user quota</h3>
                        <p class="text-muted">
                            Applied to every user unless you set a per-user override on the Users tab.
                            Leave a field blank for no limit. These are hard caps — they block manual
                            downloads too, not just the auto-downloader.
                        </p>
                        <div class="form-group row">
                            <label class="col-xs-4 col-form-label">Max videos per user:</label>
                            <div class="col-xs-8">
                                <input class="form-control" type="number" min="0" @bind="DefaultVideoQuotaStr" placeholder="Unlimited" />
                            </div>
                        </div>
                        <div class="form-group row">
                            <label class="col-xs-4 col-form-label">Max storage per user (GB):</label>
                            <div class="col-xs-8">
                                <input class="form-control" type="number" min="0" step="0.1" @bind="DefaultStorageQuotaStr" placeholder="Unlimited" />
                            </div>
                        </div>
                    </section>

                    <section class="settings-section">
                        <h3>Maintenance</h3>
                        <p class="text-muted">
                            A nightly sweep keeps the database and logs from growing without limit. It also
                            runs shortly after startup if it is overdue, so a server that restarts often
                            still gets swept.
                        </p>
                        <div class="form-group row">
                            <label class="col-xs-4 col-form-label">Run nightly sweep:</label>
                            <div class="col-xs-8">
                                <label class="inline-check">
                                    <input type="checkbox" @bind="MaintenanceEnabled" /> Prune history and clean up logs
                                </label>
                            </div>
                        </div>
                        <div class="form-group row">
                            <label class="col-xs-4 col-form-label">Sweep every (hours):</label>
                            <div class="col-xs-8">
                                <input class="form-control" type="number" min="1" @bind="MaintenanceIntervalHours" />
                                <small class="text-muted">Takes effect after a restart.</small>
                            </div>
                        </div>
                        <div class="form-group row">
                            <label class="col-xs-4 col-form-label">Keep job history for (days):</label>
                            <div class="col-xs-8">
                                <input class="form-control" type="number" min="0" @bind="JobHistoryRetentionDays" />
                                <small class="text-muted">0 disables pruning. Failed jobs are kept three times longer.</small>
                            </div>
                        </div>
                        <div class="form-group row">
                            <label class="col-xs-4 col-form-label">Keep yt-dlp logs for (days):</label>
                            <div class="col-xs-8">
                                <input class="form-control" type="number" min="0" @bind="YtdlLogRetentionDays" />
                                <small class="text-muted">
                                    Per-invocation output captures. Only written when the server runs with
                                    debug logging on, which is not the case for a normal install.
                                </small>
                            </div>
                        </div>
                    </section>

                    <section class="settings-section">
                        <h3>Database backups</h3>
                        @if (maintenance == null)
                        {
                            <p class="text-muted">Loading…</p>
                        }
                        else if (!maintenance.Supported)
                        {
                            <p class="fg-error">
                                Not available on SQL Server &mdash; a backup would have to be written on the
                                database server rather than here, and there is no compaction equivalent.
                                Back up by your usual SQL Server means. <strong>This also means no snapshot
                                is taken before schema migrations.</strong>
                            </p>
                        }
                        else
                        {
                            <p class="text-muted">
                                Snapshots are written to <code>@maintenance.BackupDirectory</code> and taken
                                without stopping the server. One is always taken before applying a schema
                                migration, and startup is refused if that fails.
                            </p>

                            <div class="form-group row">
                                <label class="col-xs-4 col-form-label">Database:</label>
                                <div class="col-xs-8">
                                    <span>@FormatSize(maintenance.DatabaseBytes)</span>
                                    @if (maintenance.WalBytes > 0)
                                    {
                                        <span class="text-muted"> + @FormatSize(maintenance.WalBytes) write-ahead log</span>
                                    }
                                    @if (maintenance.ReclaimableBytes > 0)
                                    {
                                        <div>
                                            <small class="text-muted">
                                                @FormatSize(maintenance.ReclaimableBytes.Value) of that is reusable free space.
                                            </small>
                                        </div>
                                    }
                                </div>
                            </div>

                            <div class="form-group row">
                                <label class="col-xs-4 col-form-label">Snapshots:</label>
                                <div class="col-xs-8">
                                    @if (maintenance.BackupCount == 0)
                                    {
                                        <span class="fg-error">none yet</span>
                                    }
                                    else
                                    {
                                        <span>
                                            @maintenance.BackupCount kept, @FormatSize(maintenance.BackupTotalBytes) total
                                        </span>
                                        <div><small class="text-muted">Most recent: @FormatWhen(maintenance.LatestBackupUtc)</small></div>
                                    }
                                    <div>
                                        <small class="text-muted">
                                            Last sweep: @FormatWhen(maintenance.LastSweepUtc)
                                            @if (maintenance.FreeBytes.HasValue)
                                            {
                                                <text> &middot; @FormatSize(maintenance.FreeBytes.Value) free on that filesystem</text>
                                            }
                                        </small>
                                    </div>
                                </div>
                            </div>

                            <div class="form-group row">
                                <label class="col-xs-4 col-form-label">Snapshot nightly:</label>
                                <div class="col-xs-8">
                                    <label class="inline-check">
                                        <input type="checkbox" @bind="BackupEnabled" /> Include a backup in the sweep
                                    </label>
                                </div>
                            </div>
                            <div class="form-group row">
                                <label class="col-xs-4 col-form-label">Snapshots to keep:</label>
                                <div class="col-xs-8">
                                    <input class="form-control" type="number" min="0" @bind="BackupKeepCount" />
                                    <small class="text-muted">
                                        Pre-migration snapshots are kept separately, so routine backups can't
                                        push one out. 0 keeps everything.
                                    </small>
                                </div>
                            </div>

                            <div class="form-group row">
                                <label class="col-xs-4 col-form-label">Actions:</label>
                                <div class="col-xs-8 admin-maintenance-actions">
                                    <button class="button-small" type="button" disabled="@maintenanceBusy" @onclick="OnBackupNow">
                                        Back up now
                                    </button>
                                    <button class="button-small" type="button" disabled="@maintenanceBusy" @onclick="OnRunMaintenance">
                                        Run sweep now
                                    </button>
                                    <button class="button-small" type="button" disabled="@maintenanceBusy" @onclick="OnCompact">
                                        Compact database
                                    </button>
                                    @if (!string.IsNullOrEmpty(maintenanceStatus))
                                    {
                                        <div><small class="@(maintenanceFailed ? "fg-error" : "fg-success")">@maintenanceStatus</small></div>
                                    }
                                    <div>
                                        <small class="text-muted">
                                            Compacting reclaims free space inside the database file, but briefly
                                            blocks all database access while it runs &mdash; it is not part of the
                                            nightly sweep for that reason.
                                        </small>
                                    </div>
                                </div>
                            </div>
                        }
                    </section>

                    <section class="settings-section">
                        <h3>Downloads / anti-bot</h3>
                        <p>
                            YouTube throttles heavy downloading. These space out downloads and metadata
                            fetches so the server looks like a real viewer. For the "confirm you're not a
                            bot" gate, upload a cookies.txt exported from your browser &mdash; use a
                            <strong>throwaway Google account</strong>, since download activity can get an
                            account flagged, and it is shared by all users on this server.
                        </p>
                        <div class="form-group row">
                            <label class="col-xs-4 col-form-label">Enable throttling:</label>
                            <div class="col-xs-8">
                                <input type="checkbox" @bind="ThrottleEnabled" />
                            </div>
                        </div>
                        <div class="form-group row">
                            <label class="col-xs-4 col-form-label">Sleep between metadata requests (s):</label>
                            <div class="col-xs-8">
                                <input class="form-control" type="number" min="0" @bind="SleepRequests" />
                            </div>
                        </div>
                        <div class="form-group row">
                            <label class="col-xs-4 col-form-label">Per-download sleep min / max (s):</label>
                            <div class="col-xs-8" style="display:flex; gap:.5rem;">
                                <input class="form-control" type="number" min="0" @bind="SleepInterval" />
                                <input class="form-control" type="number" min="0" @bind="MaxSleepInterval" />
                            </div>
                        </div>
                        <div class="form-group row">
                            <label class="col-xs-4 col-form-label">Download rate limit (e.g. 2M):</label>
                            <div class="col-xs-8">
                                <input class="form-control" @bind="LimitRate" placeholder="No limit" />
                            </div>
                        </div>
                        <div class="form-group row">
                            <label class="col-xs-4 col-form-label">Impersonate a browser:</label>
                            <div class="col-xs-8">
                                <select class="form-control" @bind="Impersonate" disabled="@(ImpersonateTargets.Length == 0)">
                                    <option value="">Off</option>
                                    @if (ImpersonateTargets.Length > 0)
                                    {
                                        <option value="auto">Automatic (any available)</option>
                                        @foreach (var target in ImpersonateTargets)
                                        {
                                            <option value="@target">@target</option>
                                        }
                                    }
                                    else if (!string.IsNullOrEmpty(Impersonate))
                                    {
                                        <option value="@Impersonate">@Impersonate (unavailable)</option>
                                    }
                                </select>
                                @if (ImpersonateTargets.Length == 0)
                                {
                                    <small class="fg-error">
                                        Unavailable &mdash; curl_cffi is not installed for the Python that runs
                                        yt-dlp. The Docker image ships it; on a bare-metal install run
                                        <code>pip install curl_cffi</code>.
                                    </small>
                                }
                                else
                                {
                                    <small>
                                        Makes yt-dlp's TLS fingerprint look like a real browser, which helps with
                                        the bot gate. Restart is not needed.
                                    </small>
                                }
                            </div>
                        </div>
                        <div class="form-group row">
                            <label class="col-xs-4 col-form-label">Per-host download pacing min / max (s):</label>
                            <div class="col-xs-8" style="display:flex; gap:.5rem;">
                                <input class="form-control" type="number" min="0" @bind="DownloadMinSeconds" />
                                <input class="form-control" type="number" min="0" @bind="DownloadMaxSeconds" />
                            </div>
                        </div>
                        <div class="form-group row">
                            <label class="col-xs-4 col-form-label">Per-host extraction pacing min / max (s):</label>
                            <div class="col-xs-8" style="display:flex; gap:.5rem;">
                                <input class="form-control" type="number" min="0" @bind="ExtractMinSeconds" />
                                <input class="form-control" type="number" min="0" @bind="ExtractMaxSeconds" />
                            </div>
                        </div>
                        <div class="form-group row">
                            <label class="col-xs-4 col-form-label">Max downloads per host (hour / day, 0 = ∞):</label>
                            <div class="col-xs-8" style="display:flex; gap:.5rem;">
                                <input class="form-control" type="number" min="0" @bind="MaxPerHour" />
                                <input class="form-control" type="number" min="0" @bind="MaxPerDay" />
                            </div>
                        </div>
                        <div class="form-group row">
                            <label class="col-xs-4 col-form-label">Simultaneous downloads per host:</label>
                            <div class="col-xs-8">
                                <input class="form-control" type="number" min="1" @bind="PerHostConcurrency" />
                            </div>
                        </div>
                        <div class="form-group row">
                            <label class="col-xs-4 col-form-label">Max parallel jobs (restart to change):</label>
                            <div class="col-xs-8">
                                <input class="form-control" type="number" value="@MaxParallelJobs" disabled />
                                <small>Set via the REGARD_MAX_PARALLEL_JOBS env var.</small>
                            </div>
                        </div>
                        <div class="form-group row">
                            <label class="col-xs-4 col-form-label">Cookies file:</label>
                            <div class="col-xs-8">
                                <span class="@(CookiesConfigured ? "fg-success" : "fg-error")">
                                    @(CookiesConfigured ? "cookies loaded ✓" : "no cookies")
                                </span>
                                <InputFile OnChange="OnCookiesFile" accept=".txt" />
                                @if (CookiesConfigured)
                                {
                                    <button class="secondary" type="button" @onclick="OnClearCookies">Remove</button>
                                }
                                @if (!string.IsNullOrEmpty(cookiesNote))
                                {
                                    <div><small>@cookiesNote</small></div>
                                }
                            </div>
                        </div>
                    </section>

                    <div class="form-group row">
                        <div class="col-xs-12 row">
                            <span class="@(serverSaved ? "fg-success" : "fg-error")">@serverStatus</span>
                            <button class="primary ml-auto" @onclick="OnSaveServer" disabled="@savingServer">Save</button>
                        </div>
                    </div>
                }
            </Content>
        </TabPage>

        <TabPage>
            <Title>Users</Title>
            <Content>
                @if (loadingUsers)
                {
                    <p>Loading…</p>
                }
                else
                {
                    @if (!string.IsNullOrEmpty(usersError))
                    {
                        <p class="fg-error">@usersError</p>
                    }
                    <div class="admin-users-table-wrap">
                        <table class="job-log-table admin-users-table">
                            <thead>
                                <tr>
                                    <th>User</th>
                                    <th>Role</th>
                                    <th>Usage</th>
                                    <th>Quota</th>
                                    <th>Status</th>
                                    <th>Actions</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var u in users)
                                {
                                    <tr @key="u.Id">
                                        <td>
                                            <div class="admin-user-name">@u.UserName @(IsSelf(u) ? "(you)" : "")</div>
                                            @if (!string.IsNullOrEmpty(u.Email))
                                            {
                                                <div class="admin-user-email text-muted">@u.Email</div>
                                            }
                                        </td>
                                        <td>@(u.IsAdmin ? "Admin" : "User")</td>
                                        <td>@u.VideoCount videos · @FormatSize(u.UsedBytes)</td>
                                        <td>@QuotaLabel(u)</td>
                                        <td class="@(u.IsDisabled ? "fg-error" : "fg-success")">@(u.IsDisabled ? "Disabled" : "Enabled")</td>
                                        <td class="admin-user-actions">
                                            <button class="button-small" disabled="@(IsSelf(u) && u.IsAdmin)" @onclick="() => ToggleAdmin(u)">
                                                @(u.IsAdmin ? "Remove admin" : "Make admin")
                                            </button>
                                            <button class="button-small" disabled="@IsSelf(u)" @onclick="() => ToggleEnabled(u)">
                                                @(u.IsDisabled ? "Enable" : "Disable")
                                            </button>
                                            <button class="button-small" @onclick="() => OpenQuota(u)">Set quota</button>
                                            <button class="button-small button-danger" disabled="@IsSelf(u)" @onclick="() => OpenDelete(u)">Delete</button>
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                }
            </Content>
        </TabPage>
    </TabView>
</div>

<Modal @ref="quotaModal">
    <Title>Set quota@(quotaTarget != null ? $" — {quotaTarget.UserName}" : "")</Title>
    <Body>
        <p class="text-muted">Leave a field blank to clear the override and inherit the server default.</p>
        <div class="form-group row">
            <label class="col-xs-5 col-form-label">Max videos:</label>
            <div class="col-xs-7">
                <input class="form-control" type="number" min="0" @bind="quotaVideoStr" placeholder="Default" />
            </div>
        </div>
        <div class="form-group row">
            <label class="col-xs-5 col-form-label">Max storage (GB):</label>
            <div class="col-xs-7">
                <input class="form-control" type="number" min="0" step="0.1" @bind="quotaStorageStr" placeholder="Default" />
            </div>
        </div>
        <div class="form-group row">
            <div class="col-xs-12 row">
                <button class="ml-auto" @onclick="() => quotaModal.Close()">Cancel</button>
                <button class="primary" @onclick="SaveQuota">Save</button>
            </div>
        </div>
    </Body>
</Modal>

<Modal @ref="deleteModal">
    <Title>Delete user</Title>
    <Body>
        @if (deleteTarget != null)
        {
            <p>
                Delete <strong>@deleteTarget.UserName</strong> and all of their data — subscriptions,
                videos, and downloaded files? This can't be undone.
            </p>
        }
        <div class="form-group row">
            <div class="col-xs-12 row">
                <button class="ml-auto" @onclick="() => deleteModal.Close()">Cancel</button>
                <button class="primary button-danger" @onclick="ConfirmDelete">Delete user</button>
            </div>
        </div>
    </Body>
</Modal>
